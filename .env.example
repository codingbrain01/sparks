# Supabase - required
# Get these from Project Settings > API in your Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Metered TURN server is configured as Supabase Edge Function secrets:
#   METERED_API_KEY
#   METERED_APP_NAME
# The frontend intentionally does not expose these as VITE_ variables.
